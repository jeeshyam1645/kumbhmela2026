# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres. Use the "dev" branch locally and on preview deployments.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# The old (v1) site. Pages not rebuilt yet are served from here.
# Use the old Vercel project's *.vercel.app address, not maghmelastays.in,
# once the domain points at this app.
LEGACY_SITE_URL=https://maghmelastays.in

# Public address of this site (used for canonical links and SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
